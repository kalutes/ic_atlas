# For Docker Compose. Copy to .env, then replace these examples for your LAN.
IC_ATLAS_IMAGE=ic-atlas:0.1.0
IC_ATLAS_DATA_DIR=./data
IC_ATLAS_ASSETS_DIR=./assets
# Download missing catalog images at startup. Use 0 for a fully offline start.
DOWNLOAD_ASSETS=1
# Set to the server's LAN IP to expose only that interface.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Exact browser origin, no trailing slash. Change when using a LAN IP or proxy.
APP_ORIGIN=http://localhost:3000
APP_UID=1000
APP_GID=1000
